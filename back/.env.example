PORT=3000
FRONT_URL=http://localhost:4200

# MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/trochita

# JWT: texto largo y aleatorio (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"). El token dura 15 minutos
JWT_SECRET=cambiame

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Imagen de perfil cuando el usuario no sube una (URL)
IMAGEN_PERFIL_DEFECTO=

# Cuentas del seed (acceso rápido). Opcionales: estos son los valores por defecto
SEED_USUARIO_CORREO=usuario@trochita.com
SEED_USUARIO_CONTRASENA=Trochita123
SEED_ADMIN_CORREO=admin@trochita.com
SEED_ADMIN_CONTRASENA=Trochita123
SEED_DESHABILITADO_CORREO=deshabilitado@trochita.com
SEED_DESHABILITADO_CONTRASENA=Trochita123
